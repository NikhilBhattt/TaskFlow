# Copy to client/.env if you need to change the defaults. Both values are optional.

# Base URL of the API for production builds / non-proxied setups (no trailing slash).
# Leave empty in development: requests go to /api and the Vite dev server proxies them.
VITE_API_URL=

# Where the Vite dev server proxies /api requests (development only).
API_PROXY_TARGET=http://localhost:8000
