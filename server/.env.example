# Copy to server/.env and fill in. Never commit the real .env file.

# --- Server ---
PORT=8000
CORS_ORIGIN=http://localhost:5173

# --- Databases (defaults match a local install; docker compose overrides these itself) ---
MONGODB_URI=localhost:27017/taskflow
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Email jobs: Gmail account + app password (https://myaccount.google.com/apppasswords) ---
# If left empty, email jobs fail after their retries and land in the dead-letter queue.
EMAIL_USER=
EMAIL_PASSWORD=

# --- PDF jobs: Cloudinary credentials (Dashboard > API Keys) ---
# If left empty, PDF jobs are generated but the upload fails, so they end up in the dead-letter queue.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

